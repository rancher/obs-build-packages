<services>
  <service name="obs_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/derailed/k9s.git</param>
    <param name="revision">558caafe7ba067467de46b320cc22ef11fef9c34</param>
    <param name="version">0.51.10</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="filename">k9s</param>
  </service>
  <service name="go_modules">
    <param name="compression">zst</param>
    <param name="replace">github.com/aws/aws-sdk-go-v2/service/s3=github.com/aws/aws-sdk-go-v2/service/s3@v1.97.3</param>
    <param name="replace">golang.org/x/crypto=golang.org/x/crypto@v0.52.0</param>
    <param name="replace">golang.org/x/net=golang.org/x/net@v0.56.0</param>
    <param name="replace">golang.org/x/sys=golang.org/x/sys@v0.44.0</param>
    <param name="replace">golang.org/x/text=golang.org/x/text@v0.39.0</param>
    <param name="replace">oras.land/oras-go/v2=oras.land/oras-go/v2@v2.6.1</param>
  </service>
  <service name="set_version" mode="buildtime"/>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
</services>
